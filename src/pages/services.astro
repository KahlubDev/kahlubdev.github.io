---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Services" sideBarActiveItemID="services">
  <div class="mb-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">Services</h1>
    <p class="text-base-content/70 text-lg max-w-2xl">
      I offer practical technical solutions across software development, infrastructure, and consulting.
    </p>
  </div>

  <div class="space-y-6">
    <HorizontalCard
      title="Full Stack Software Development"
      img="/5.webp"
      desc="Building modern, scalable web and Android applications using React, Next.js, Node.js, Flutter and more. Focused on clean code, performance and good user experience."
      url="#"
      badge="Popular"
      tags={["Web", "Mobile", "Full Stack"]}
    />

    <HorizontalCard
      title="Cloud Solutions & DevOps"
      img="/5.webp"
      desc="Helping businesses set up, migrate and optimise cloud infrastructure on AWS, Vercel and DigitalOcean. Reliable deployments and cost-aware architecture."
      url="#"
      badge="Trending"
      tags={["Cloud", "DevOps"]}
    />

    <HorizontalCard
      title="Database Design & Optimisation"
      img="/5.webp"
      desc="Designing efficient database systems with PostgreSQL, MongoDB and MySQL. Includes data modelling, performance tuning and secure architecture."
      url="#"
      tags={["Database", "Backend"]}
    />

    <HorizontalCard
      title="Networking & Hardware Solutions"
      img="/5.webp"
      desc="Network setup, configuration, troubleshooting, hardware upgrades and IT infrastructure support for businesses and individuals."
      url="#"
      tags={["Networking", "Hardware"]}
    />

    <HorizontalCard
      title="Technical Consulting & Mentorship"
      img="/5.webp"
      desc="Strategic technical advice, system architecture planning, code reviews and mentoring for developers looking to grow."
      url="#"
      tags={["Consulting", "Mentorship"]}
    />
  </div>
</BaseLayout>