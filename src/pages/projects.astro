---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">Projects</h1>
    <p class="text-base-content/70 text-lg max-w-2xl">
      Selected client work, product builds, and systems experiments across web, fintech, and secure backend development.
    </p>
  </div>

  <!-- Completed -->
  <div class="mb-6">
    <h2 class="text-2xl font-semibold mb-6">Completed</h2>
  </div>
    <HorizontalCard
      title="VNet-L2"
      img="/VNet-L2.webp"
      desc="A Rust-based Layer 2 virtual network switch inspired by ZeroTier-style virtual networking. Explores Ethernet frame representation, MAC address handling and learning, known destination forwarding, unknown destination flooding, broadcast handling, and UDP transport. Built as an independent networking and systems programming project with a modular Rust architecture."
      url="https://github.com/KahlubDev/VNet-L2"
      target="_blank"
      badge="Completed"
      tags={["Rust", "Layer 2 Networking", "UDP", "MAC Learning"]}
      />
    <HorizontalCard
      title="Weather App"
      img="/weather-app.webp"
      desc="A weather lookup app built with vanilla JavaScript. Search any city and view live temperature, conditions, and icons, fetched from the OpenWeatherMap API. Includes a secure deployment pipeline that keeps API keys out of Git and injects them at build time on Vercel."
      url="https://simple-weather-app-six-rose.vercel.app/"
      target="_blank"
      badge="Completed"
      tags={["JavaScript", "REST API", "Responsive Design"]}
      />
      <HorizontalCard
      title="Java HTTP Server"
      img="/java-http-server.webp"
      desc="Lightweight multi-threaded HTTP server built from scratch in core Java. Implements TCP sockets, request parsing, routing, static file serving, JSON APIs, thread pool concurrency, and basic directory traversal protection — no Spring or Tomcat."
      url="https://github.com/KahlubDev/JavaHttpServer"
      target="_blank"
      badge="Completed"
      tags={["Java", "Networking", "HTTP"]}
    />

      <HorizontalCard
      title="Secure CI Demo"
      img="/Secure-ci.webp"
      desc="Rust API with automated secure CI. Pipeline runs build, tests, Semgrep SAST (custom SQL-injection rule), and Gitleaks secret scanning. Demonstrates blocking findings, SHA-pinned Actions, and keeping demo vulnerabilities off main."
      url="https://github.com/KahlubDev/secure-ci-demo"
      target="_blank"
      badge="Completed"
      tags={["Rust", "CI/CD", "Security" ,"Gitleaks", "SQLite"]}
    />
  <div class="space-y-6 mb-16">
    <HorizontalCard
      title="AgriPay"
      img="/agripay-logo.webp"
      desc="Farmer loan scoring and M-Pesa disbursement MVP. Built explainable scoring rules, loan offer flow, and real PayHero integration for disbursement and STK Push repayment. Stack: React (Vite), Express, Node.js, PayHero."
      url="https://github.com/KahlubDev/agripay"
      target="_blank"
      badge="Completed"
      tags={["Fintech", "React", "Node.js"]}
    />

    <HorizontalCard
      title="Secure Notes"
      img="/5.webp"
      desc="Rust notes API focused on practical application security. Implemented database-backed notes, intentional SQL injection demonstration, and a remediated parameterised-query version to show secure coding in context."
      url="https://github.com/KahlubDev/secure-notes"
      target="_blank"
      badge="Completed"
      tags={["Rust", "Security", "SQLite"]}
    />

    <HorizontalCard
      title="Mini Redis (Tokio)"
      img="/5.webp"
      desc="Redis-compatible server in Rust using Tokio. Implements GET/SET with async I/O, concurrent client handling via tokio::spawn, protocol framing, tracing, and async unit tests."
      url="https://github.com/KahlubDev/my-redis"
      target="_blank"
      badge="Completed"
      tags={["Rust", "Tokio", "Systems"]}
    />

    <HorizontalCard
      title="Muslim Association Nakuru"
      img="/man-logo.webp"
      desc="Web platform for a Nakuru-based non-profit. Built the public-facing site to present programmes, improve information access, and support organisational visibility. Stack: HTML, CSS, JavaScript, PHP, Apache, AWS."
      url="https://muslimassociationnakuru.org/"
      target="_blank"
      badge="Completed"
      tags={["Web App", "PHP", "AWS"]}
    />

    <HorizontalCard
      title="CareNest"
      img="/carenest.webp"
      desc="Website for a Kenyan mental wellness company. Acted as project manager and contributed to delivery of a clean, responsive site focused on service presentation and contact flow."
      url="https://carenest.co.ke/"
      target="_blank"
      badge="Completed"
      tags={["Website", "Project Management"]}
    />

    <HorizontalCard
      title="Mediskool"
      img="/mediskool-logo.webp"
      desc="Team lead on a web platform for medical practitioners. Focused on coordination, structure, and delivery of a functional public site."
      url="https://mediskool.site/"
      target="_blank"
      badge="Completed"
      tags={["Web Platform", "Team Lead"]}
    />
  </div>

  <!-- Ongoing -->
  <div class="mb-6">
    <h2 class="text-2xl font-semibold mb-6">Ongoing / Experiments</h2>
  </div>

  <div class="space-y-6">
    <HorizontalCard
      title="Video Player"
      img="/5.webp"
      desc="A video player written in C with support for multiple formats. Focused on learning systems-level media handling and performance."
      url="#"
      badge="Ongoing"
      tags={["C", "Systems"]}
    />

    <HorizontalCard
      title="Load Balancer"
      img="/5.webp"
      desc="Custom load balancing experiment aimed at distributing traffic based on practical use cases and reducing server overload."
      url="#"
      badge="Ongoing"
      tags={["Networking", "Infrastructure"]}
    />

    <HorizontalCard
      title="Android Auto Clicker"
      img="/5.webp"
      desc="Android utility designed to perform timed clicks with minimal user interaction. Built as a practical automation experiment."
      url="#"
      badge="Ongoing"
      tags={["Android", "Automation"]}
    />
  </div>
</BaseLayout>