---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Done Projects</div>
  </div>

  <HorizontalCard
    title="Muslim Association Nakuru"
    img="/MAN Logo.webp"
    desc="A digital solution for a Non Profit Organization based in Nakuru, Kenya"
    url="https://muslimassociationnakuru.org"
    badge="COMPLETED"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="CareNest"
    img="/CareNest Logo(2)-page-0.webp"
    desc="A modern website for a Mental Wellness company based in Kenya"
    url="https://carenest.co.ke/"
  />
  <HorizontalCard
    title="Mediskool"
    img="/Mediskool Logo.webp"
    desc="A health solution for medical practioners"
    url="https://mediskool.site/"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10"> New/Ongoing Projects</div>
  </div>

  <HorizontalCard
    title="Video Player"
    img="/5.webp"
    desc="A video player built by C that can play most available formats"
    url="#"
    badge="Ongoing"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Load balancer"
    img="/5.webp"
    desc="A modern solution to ensure that servers are not overloaded, fully customised based on use case"
    url="#"
  />
  <div class="Android Auto clicker"></div>
  <HorizontalCard
    title="Android"
    img="/5.webp"
    desc="An android solution to automatically click on the timer with minimal user interaction."
    url="#"
  />
</BaseLayout>
