---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify leading-relaxed">
    Passionate Full Stack Software Developer,Systems and Hardware Engineer from Nakuru, Kenya, with a strong foundation in building modern, scalable, 
    and user-friendly web applications. I enjoy solving complex problems and turning ideas into functional digital products. 
    Experienced in both frontend and backend development with a focus on clean code and excellent user experience.
  </div>

  <!-- Education -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Bachelor of Science in Computer Science"
      subtitle="2025— 2027 | Kabarak University, Nakuru, Kenya"
    >
      Relevant Coursework: Data Structures & Algorithms, Web Development, Software Engineering, Database Systems, Mobile Computing.
    </TimeLineElement>
    <TimeLineElement
      title="Diploma  in Information Technnology"
      subtitle="2022— 2024 | Jomo Kenyatta University of Agriculture and  Technology, Juja, Kenya"
    >
      Relevant Coursework: Data Structures & Algorithms, Web Development, Software Engineering, Database Systems, Mobile Computing.
    </TimeLineElement>
  </div>

  <!-- Experience -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Full Stack Developer"
      subtitle="Jan 2020 — Present | Freelance & Personal Projects"
    >
      <ul class="list-disc list-inside space-y-1">
        <li>Developed multiple full-stack web applications using React, Next.js, Astro, Node.js and Tailwind CSS</li>
        <li>Built responsive and high-performance user interfaces</li>
        <li>Integrated RESTful APIs and third-party services</li>
        <li>Focused on writing clean, maintainable, and well-documented code</li>
      </ul>
    </TimeLineElement>

    <TimeLineElement
      title="Software Developer Intern"
      subtitle="January 2024 — May 2024| [County Government of Nakuru], Nakuru, Kenya"
    >
      <ul class="list-disc list-inside space-y-1">
        <li>Collaborated with a team to develop internal tools and client-facing applications</li>
        <li>Worked on frontend development and API integration</li>
        <li>Gained hands-on experience with agile development methodologies</li>
      </ul>
    </TimeLineElement>
  </div>

  <!-- Certifications -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li><a href="#" target="_blank">Google IT Support Professional Certificate</a></li>
    <li><a href="#" target="_blank">Meta Front-End Developer Professional Certificate</a></li>
    <li><a href="#" target="_blank">FreeCodeCamp - Responsive Web Design</a></li>
    <li><a href="#" target="_blank">IBM Cloud Security</a></li>
    <li><a href="#" target="_blank">Cisco Netwrking Fundamentals</a></li>
    <li><a href="#" target="_blank">Cisco Certified Network Administrator</a></li>
    <li><a href="#" target="_blank">Certified Ethical Hacker</a></li>
    
  </ul>

  <!-- Skills -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-3 columns-2 mx-6 leading-relaxed">
    <li>JavaScript (ES6+)</li>
    <li>TypeScript</li>
    <li>React / Next.js</li>
    <li>Astro Framework</li>
    <li>Node.js & Express</li>
    <li>Tailwind CSS</li>
    <li>PostgreSQL & MongoDB</li>
    <li>Git & GitHub</li>
    <li>RESTful APIs</li>
    <li>Problem Solving & Debugging</li>
    <li>UI/UX Principles</li>
  </ul>
</BaseLayout>