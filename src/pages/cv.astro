---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Experience" sideBarActiveItemID="cv">
  <!-- Profile -->
  <div class="mb-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Experience</h1>
    <p class="text-base-content/80 leading-relaxed max-w-3xl">
      Full Stack Developer based in Nakuru, Kenya. I build practical web applications and continuously expand my skills across software development, systems, and infrastructure. I value clean code, reliable solutions, and steady improvement through real projects.
    </p>
  </div>

  <!-- Experience -->
  <div class="mb-12">
    <h2 class="text-2xl font-semibold mb-6">Work Experience</h2>

    <div class="time-line-container space-y-8">
      <TimeLineElement
        title="Full Stack Developer"
        subtitle="2023 — Present | Freelance & Personal Projects"
      >
        <ul class="list-disc list-inside space-y-1.5 text-base-content/80">
          <li>Developed full-stack web applications using React, Next.js, Astro, Node.js and Tailwind CSS</li>
          <li>Built responsive interfaces focused on performance and usability</li>
          <li>Integrated APIs and third-party services into production-ready projects</li>
          <li>Maintained clean, readable code across personal and client work</li>
        </ul>
      </TimeLineElement>

      <TimeLineElement
        title="Software Developer Intern"
        subtitle="Jan 2024 — May 2024 | County Government of Nakuru"
      >
        <ul class="list-disc list-inside space-y-1.5 text-base-content/80">
          <li>Collaborated with a team on internal tools and client-facing applications</li>
          <li>Contributed to frontend development and API integration</li>
          <li>Gained practical experience with team workflows and agile practices</li>
        </ul>
      </TimeLineElement>
    </div>
  </div>

  <!-- Skills -->
    <!-- Skills -->
  <div class="mb-12">
    <h2 class="text-2xl font-semibold mb-6">Skills</h2>

    <div class="flex flex-wrap gap-3">
      <span class="badge badge-outline badge-lg px-4 py-3">JavaScript / TypeScript</span>
      <span class="badge badge-outline badge-lg px-4 py-3">React / Next.js</span>
      <span class="badge badge-outline badge-lg px-4 py-3">Astro</span>
      <span class="badge badge-outline badge-lg px-4 py-3">Node.js & Express</span>
      <span class="badge badge-outline badge-lg px-4 py-3">Tailwind CSS</span>
      <span class="badge badge-outline badge-lg px-4 py-3">PostgreSQL / MongoDB</span>
      <span class="badge badge-outline badge-lg px-4 py-3">Git & GitHub</span>
      <span class="badge badge-outline badge-lg px-4 py-3">REST APIs</span>
      <span class="badge badge-outline badge-lg px-4 py-3">Problem Solving</span>
    </div>
  </div>

  <!-- Certifications -->
  <div class="mb-12">
    <h2 class="text-2xl font-semibold mb-6">Certifications</h2>
    <ul class="space-y-2 text-base-content/80">
      <li>Google IT Support Professional Certificate</li>
      <li>Meta Front-End Developer Professional Certificate</li>
      <li>freeCodeCamp — Responsive Web Design</li>
      <li>IBM Cloud Security</li>
      <li>Cisco Networking Fundamentals</li>
      <li>Cisco Certified Network Associate </li>
      <li>Cisco Certified Network Professional (In progress) </li>
      <li>Certified Ethical Hacker</li>
    </ul>
  </div>

  <!-- Download CV -->
  <div class="pt-4">
    <a href="#" class="btn btn-primary">
      Download CV
    </a>
    <p class="text-sm text-base-content/50 mt-3">
      PDF version coming soon.
    </p>
  </div>
</BaseLayout>