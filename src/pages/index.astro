---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <!-- Hero Section -->
  <section class="pb-16 pt-8 md:pt-12">
    <div class="max-w-3xl">
      <p class="text-lg text-base-content/70 mb-3" id="hero-greeting">
        Hey there 
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4" id="hero-name">
        I'm Caleb Mwangi
      </h1>
      <h2 class="text-2xl md:text-3xl font-semibold text-base-content/80 mb-6" id="hero-role">
        Software Developer & Problem Solver
      </h2>
      <p class="text-lg leading-relaxed text-base-content/70 max-w-2xl mb-8" id="hero-bio">
        Passionate Full Stack Developer from Nakuru, Kenya. I build modern, scalable web applications and love turning ideas into reality with clean code.
      </p>

      <div class="flex flex-wrap gap-4" id="hero-ctas">
        <a href="#projects" class="btn btn-primary">
          View Projects
        </a>
        <a href="/cv" class="btn btn-outline">
          Download CV
        </a>
        <a href="https://github.com/KahlubDev" target="_blank" class="btn btn-ghost">
          GitHub
        </a>
      </div>
    </div>
  </section>

   <!-- Featured Projects -->
  <section id="projects" class="mt-8 mb-20">
    <div class="flex items-end justify-between mb-8">
      <h2 class="text-3xl font-bold">Featured Projects</h2>
      <a href="/projects" class="text-sm text-primary hover:underline hidden sm:inline-block">
        View all →
      </a>
    </div>

          <HorizontalCard
        title="Secure CI Demo"
        img="/Secure-ci.webp"
        desc="Rust API with secure GitHub Actions CI: Semgrep SAST, Gitleaks, build/test gates, and blocking security findings."
        url="https://github.com/KahlubDev/secure-ci-demo"
        target="_blank"
        badge="Featured"
        tags={["Rust", "CI/CD", "Security"]}
      />


      <div class="space-y-6">
      <HorizontalCard
        title="AgriPay"
        img="/agripay-logo.webp"
        desc="Farmer loan scoring and M-Pesa disbursement MVP. Explainable scoring rules plus real PayHero integration for disbursement and repayment. React, Express, Node.js."
        url="https://github.com/KahlubDev/agripay"
        target="_blank"
        badge="Featured"
        tags={["Fintech", "React", "Node.js"]}
      />
     
      <div class="divider my-0"></div>

      <HorizontalCard
        title="Mini Redis (Tokio)"
        img="/5.webp"
        desc="Redis-compatible server in Rust with Tokio. Async GET/SET, concurrent connections, protocol framing, and async tests."
        url="https://github.com/KahlubDev/my-redis"
        target="_blank"
        tags={["Rust", "Tokio", "Systems"]}
      />
      <div class="divider my-0"></div>

      <HorizontalCard
        title="Java HTTP Server"
        img="/java-http-server.webp"
        desc="Lightweight multi-threaded HTTP server built from scratch in core Java. Implements TCP sockets, request parsing, routing, static file serving, JSON APIs, thread pool concurrency, and basic directory traversal protection — no Spring or Tomcat."
        url="https://github.com/KahlubDev/JavaHttpServer"
        target="_blank"
        tags={["Java", "Networking", "HTTP"]}
      />
      <div class="divider my-0"></div>

      <HorizontalCard
        title="Muslim Association Nakuru"
        img="/man-logo.webp"
        desc="Web platform for a Nakuru-based non-profit. Public site for programmes, information access, and organisational visibility."
        url="https://muslimassociationnakuru.org/"
        target="_blank"
        tags={["Web App", "PHP", "AWS"]}
      />
    </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { animate, stagger } from "animejs";

  // Hero entrance animation
  const heroElements = [
    "#hero-greeting",
    "#hero-name",
    "#hero-role",
    "#hero-bio",
    "#hero-ctas"
  ];

  animate(heroElements, {
    opacity: [0, 1],
    translateY: [24, 0],
    delay: stagger(120),
    duration: 700,
    easing: "easeOutCubic"
  });
</script>