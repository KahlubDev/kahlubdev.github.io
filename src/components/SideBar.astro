---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";

const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-4 pt-6 h-auto min-h-full w-[18rem] bg-base-200 text-base-content flex flex-col">
    
    <!-- Profile -->
    <div class="flex flex-col items-center mb-8">
      <a href="/" class="block">
        <div class="avatar">
          <div class="w-28 rounded-full ring ring-base-300 ring-offset-base-200 ring-offset-2">
            <Image
              src="/5.webp"
              width={300}
              height={300}
              format="webp"
              alt="Caleb Mwangi"
              class="object-cover"
            />
          </div>
        </div>
      </a>
      <h2 class="mt-4 text-lg font-semibold">Caleb Mwangi</h2>
      <p class="text-sm text-base-content/60">Software Developer</p>
    </div>

    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>