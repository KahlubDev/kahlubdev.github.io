---
const { 
  title, 
  img, 
  desc, 
  url, 
  badge, 
  tags, 
  target = "_self"   // Changed default to same tab
} = Astro.props;

import { Image } from "astro:assets";

const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div class="rounded-xl bg-base-100 border border-base-300/50 hover:border-primary/30 hover:shadow-lg transition-all duration-300">
  <a href={url} target={target} class="block p-1">
    <div class="flex flex-col md:flex-row gap-5 p-4 md:p-5 items-start">
      
      {img && (
        <div class="w-full md:w-48 flex-shrink-0">
          <Image
            src={img}
            width={400}
            height={225}
            format="webp"
            alt={title}
            class="w-full h-auto rounded-lg object-cover"
          />
        </div>
      )}

      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-3 mb-2">
          <h3 class="text-lg md:text-xl font-semibold leading-snug">
            {title}
          </h3>
          {badge && (
            <span class="badge badge-primary badge-sm whitespace-nowrap">
              {badge}
            </span>
          )}
        </div>

        <p class="text-base-content/70 text-sm md:text-base leading-relaxed mb-4">
          {desc}
        </p>

        {tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="badge badge-outline badge-sm">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </a>
</div>