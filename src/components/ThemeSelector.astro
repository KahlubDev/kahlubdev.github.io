---
---

<div class="dropdown dropdown-end">
  <label tabindex="0" class="btn btn-ghost flex items-center gap-2 hover:bg-base-200 px-3">
    <!-- Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2 2 2 0 01-2-2 2 2 0 012-2 2 2 0 01-2-2 2 2 0 012-2z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13a4 4 0 01-4 4m4-4a4 4 0 00-4-4" />
    </svg>
    <!-- Text Label -->
    <span class="font-medium text-sm hidden md:inline">Theme</span>
  </label>
  
  <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-52 mt-2 z-50">
    <li><button onclick="setTheme('light')" class="flex items-center gap-2">🌞 Light</button></li>
    <li><button onclick="setTheme('dark')" class="flex items-center gap-2">🌙 Dark</button></li>
    <li><button onclick="setTheme('cupcake')" class="flex items-center gap-2">🧁 Cupcake</button></li>
    <li><button onclick="setTheme('bumblebee')" class="flex items-center gap-2">🐝 Bumblebee</button></li>
    <li><button onclick="setTheme('emerald')" class="flex items-center gap-2">💎 Emerald</button></li>
    <li><button onclick="setTheme('corporate')" class="flex items-center gap-2">🏢 Corporate</button></li>
    <li><button onclick="setTheme('synthwave')" class="flex items-center gap-2">🌃 Synthwave</button></li>
  </ul>
</div>

<script>
  window.setTheme = function(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  // Load saved theme on page load
  const saved = localStorage.getItem('theme');
  if (saved) {
    document.documentElement.setAttribute('data-theme', saved);
  } else {
    // Default to dark if nothing saved
    document.documentElement.setAttribute('data-theme', 'dark');
  }
</script>