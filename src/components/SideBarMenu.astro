---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300 font-medium";
---

<ul class="menu menu-md grow shrink overflow-y-auto px-1">
  <li>
    <a id="home" href="/" class="py-3 text-base">Home</a>
  </li>
  <li>
    <a id="projects" href="/projects" class="py-3 text-base">Projects</a>
  </li>
  <li>
    <a id="services" href="/services" class="py-3 text-base">Services</a>
  </li>
  <li>
    <a id="blog" href="/blog/" class="py-3 text-base">Blog</a>
  </li>
  <li>
    <a id="cv" href="/cv" class="py-3 text-base">CV</a>
  </li>
  <li>
    <a
      href="mailto:contact.njogumwangi@gmail.com"
      class="py-3 text-base"
      target="_blank"
      rel="noopener noreferrer"
    >
      Contact
    </a>
  </li>
</ul>

<script define:vars={{ sideBarActiveItemID, activeClass }}>
  const activeItem = document.getElementById(sideBarActiveItemID);
  if (activeItem) {
    activeItem.classList.add(...activeClass.split(" "));
  }
</script>