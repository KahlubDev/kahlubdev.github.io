---
import ThemeSelector from "./ThemeSelector.astro";
---

<!-- Mobile Header -->
<div class="sticky lg:hidden top-0 z-30 flex h-16 w-full justify-center bg-base-100/90 backdrop-blur-md border-b border-base-300/50">
  <div class="navbar px-4">
    <div class="navbar-start">
      <label for="my-drawer" class="btn btn-square btn-ghost">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    </div>

    <div class="navbar-center">
      <a href="/" class="text-lg font-semibold tracking-tight">
        Caleb Mwangi
      </a>
    </div>

    <div class="navbar-end">
      <ThemeSelector />
    </div>
  </div>
</div>

<!-- Desktop Header -->
<div class="hidden lg:flex sticky top-0 z-30 bg-base-100/90 backdrop-blur-md border-b border-base-300/50">
  <div class="navbar max-w-7xl mx-auto px-8 w-full">
    <div class="navbar-start">
      <a href="/" class="text-xl font-bold tracking-tight">
        Caleb Mwangi
      </a>
    </div>

    <div class="navbar-end">
      <ThemeSelector />
    </div>
  </div>
</div>