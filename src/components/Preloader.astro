---

<div id="preloader" class="fixed inset-0 z-[99999] flex items-center justify-center bg-base-100 hidden">
  <div class="text-center px-6 max-w-[280px]">
    <div id="logo" class="mx-auto mb-6 text-5xl font-black tracking-tighter">
      K<span class="text-primary">D</span>
    </div>

    <div class="font-mono text-base mb-6 text-base-content/70 min-h-[26px]">
      <span id="typing-text"></span>
      <span class="inline-block w-1.5 h-5 bg-primary animate-pulse ml-1"></span>
    </div>

    <div class="w-56 mx-auto h-1 bg-base-300 rounded-full overflow-hidden">
      <div id="progress" class="h-full bg-gradient-to-r from-primary to-secondary w-0 rounded-full"></div>
    </div>
  </div>
</div>

<script is:inline>
  const preloader = document.getElementById('preloader');

  if (!sessionStorage.getItem('hasVisited')) {
    preloader.classList.remove('hidden');
    sessionStorage.setItem('hasVisited', 'true');

    // Auto hide after 4 seconds max (safety)
    setTimeout(() => {
      preloader.style.transition = 'opacity 0.6s ease';
      preloader.style.opacity = '0';
      setTimeout(() => {
        preloader.style.display = 'none';
      }, 600);
    }, 4000);
  } else {
    preloader.style.display = 'none';
  }
</script>