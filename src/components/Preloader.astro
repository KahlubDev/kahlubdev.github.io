---

<div id="preloader" class="fixed inset-0 z-[99999] flex items-center justify-center bg-base-100 hidden">
  <div class="text-center px-6 max-w-[280px]">
    <div class="mx-auto mb-6 text-5xl font-black tracking-tighter">
      Caleb<span class="text-primary">Mwangi</span>
    </div>

    <div class="font-mono text-sm mb-6 text-base-content/70 min-h-[24px] flex items-center justify-center">
      <span id="typing-text"></span>
      <span class="inline-block w-1.5 h-4 bg-primary animate-pulse ml-1"></span>
    </div>

    <div class="w-56 mx-auto h-1 bg-base-300 rounded-full overflow-hidden">
      <div id="progress" class="h-full bg-gradient-to-r from-primary to-secondary w-0 rounded-full"></div>
    </div>
  </div>
</div>

<script is:inline>
  const preloader = document.getElementById('preloader');
  const typingElement = document.getElementById('typing-text');
  const progressBar = document.getElementById('progress');

  // Only show on first visit of the session
  if (!sessionStorage.getItem('hasVisited')) {
    preloader.classList.remove('hidden');
    sessionStorage.setItem('hasVisited', 'true');

    const messages = [
      "Booting portfolio...",
      "Loading projects...",
      "Almost ready"
    ];

    function typeMessage(text, callback) {
      typingElement.textContent = '';
      let i = 0;
      const interval = setInterval(() => {
        if (i < text.length) {
          typingElement.textContent += text.charAt(i);
          i++;
        } else {
          clearInterval(interval);
          if (callback) setTimeout(callback, 280);
        }
      }, 45);
    }

    function startProgress() {
      let width = 0;
      const interval = setInterval(() => {
        width += 3;
        progressBar.style.width = width + '%';
        if (width >= 100) clearInterval(interval);
      }, 40);
    }

    function hidePreloader() {
      preloader.style.transition = 'opacity 0.7s ease';
      preloader.style.opacity = '0';
      setTimeout(() => {
        preloader.style.display = 'none';
      }, 700);
    }

    startProgress();
    let index = 0;

    const showNext = () => {
      if (index < messages.length) {
        typeMessage(messages[index], () => {
          index++;
          showNext();
        });
      } else {
        setTimeout(hidePreloader, 600);
      }
    };

    showNext();
  } else {
    preloader.style.display = 'none';
  }
</script>