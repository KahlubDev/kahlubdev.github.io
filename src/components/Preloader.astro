---
---

<!-- Cool Preloader - Shows only on first visit -->
<div id="preloader" class="fixed inset-0 z-[99999] flex items-center justify-center bg-base-100 hidden">
  <div class="text-center">
    <!-- Animated Logo -->
    <div id="logo" class="mx-auto mb-8 text-7xl font-black tracking-tighter text-base-content">
      Caleb<span class="text-primary">Mwangi</span>
    </div>

    <!-- Typing Effect -->
    <div class="font-mono text-lg mb-8 text-base-content/70 min-h-[32px] flex items-center justify-center">
      <span id="typing-text"></span>
      <span class="inline-block w-2 h-6 bg-primary animate-pulse ml-1"></span>
    </div>

    <!-- Progress Bar -->
    <div class="w-80 mx-auto h-1.5 bg-base-300 rounded-full overflow-hidden">
      <div id="progress" class="h-full bg-gradient-to-r from-primary to-secondary w-0 rounded-full"></div>
    </div>

    <p class="mt-4 text-sm text-base-content/50">Loading amazing things...</p>
  </div>
</div>

<script is:inline>
  const preloader = document.getElementById('preloader');
  const typingElement = document.getElementById('typing-text');
  const progressBar = document.getElementById('progress');

  const messages = [
    "Booting portfolio...",
    "Loading projects.exe",
    "Fetching experience data...",
    "Connecting neurons...",
    "Almost there ✨"
  ];

  function typeMessage(text, callback) {
    typingElement.textContent = '';
    let i = 0;
    const interval = setInterval(() => {
      if (i < text.length) {
        typingElement.textContent += text.charAt(i);
        i++;
      } else {
        clearInterval(interval);
        if (callback) setTimeout(callback, 250);
      }
    }, 45);
  }

  function startProgress() {
    let width = 0;
    const interval = setInterval(() => {
      width += 2;
      progressBar.style.width = width + '%';
      if (width >= 100) clearInterval(interval);
    }, 35);
  }

  function hidePreloader() {
    preloader.style.transition = 'opacity 0.8s ease';
    preloader.style.opacity = '0';
    setTimeout(() => preloader.style.display = 'none', 800);
  }

  // Check if this is the first visit in this session
  const hasVisited = sessionStorage.getItem('hasVisited');

  if (!hasVisited) {
    // First time visitor → Show loader
    preloader.classList.remove('hidden');
    sessionStorage.setItem('hasVisited', 'true');

    startProgress();
    let index = 0;

    const showNext = () => {
      if (index < messages.length) {
        typeMessage(messages[index], () => {
          index++;
          showNext();
        });
      } else {
        setTimeout(hidePreloader, 700);
      }
    };

    showNext();
  }
</script>