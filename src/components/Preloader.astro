---

<div id="preloader" class="fixed inset-0 z-[99999] flex items-center justify-center bg-base-100">
  <div class="text-center px-6 max-w-[280px]">
    <!-- Compact Logo -->
    <div id="logo" class="mx-auto mb-6 text-5xl font-black tracking-tighter text-base-content">
      Caleb<span class="text-primary">Mwangi</span>
    </div>

    <!-- Typing Effect -->
    <div class="font-mono text-[15px] mb-6 text-base-content/70 min-h-[26px]">
      <span id="typing-text"></span>
      <span class="inline-block w-1 h-4 bg-primary animate-pulse ml-1 align-middle"></span>
    </div>

    <!-- Slim Progress Bar -->
    <div class="w-56 mx-auto h-1 bg-base-300 rounded-full overflow-hidden">
      <div id="progress" class="h-full bg-gradient-to-r from-primary to-secondary w-0 rounded-full transition-all"></div>
    </div>

    <p class="mt-5 text-xs text-base-content/60">Loading portfolio...</p>
  </div>
</div>

<script is:inline>
  const preloader = document.getElementById('preloader');
  const typingElement = document.getElementById('typing-text');
  const progressBar = document.getElementById('progress');

  const messages = [
    "Booting portfolio...",
    "Loading projects...",
    "Fetching experience...",
    "Almost ready ✨"
  ];

  function typeMessage(text, callback) {
    typingElement.textContent = '';
    let i = 0;
    const interval = setInterval(() => {
      if (i < text.length) {
        typingElement.textContent += text.charAt(i);
        i++;
      } else {
        clearInterval(interval);
        if (callback) setTimeout(callback, 250);
      }
    }, 45);
  }

  function startProgress() {
    let width = 0;
    const interval = setInterval(() => {
      width += 2.5;
      progressBar.style.width = width + '%';
      if (width >= 100) clearInterval(interval);
    }, 38);
  }

  function hidePreloader() {
    preloader.style.transition = 'opacity 0.85s ease';
    preloader.style.opacity = '0';
    setTimeout(() => preloader.style.display = 'none', 850);
  }

  // Show only on first visit
  if (!sessionStorage.getItem('hasVisited')) {
    preloader.classList.remove('hidden');
    sessionStorage.setItem('hasVisited', 'true');

    startProgress();
    let index = 0;

    const showNext = () => {
      if (index < messages.length) {
        typeMessage(messages[index], () => {
          index++;
          showNext();
        });
      } else {
        setTimeout(hidePreloader, 700);
      }
    };
    showNext();
  }
</script>