---
---

<div id="preloader" class="fixed inset-0 z-[99999] flex items-center justify-center bg-base-100 hidden">
  <div class="text-center px-6 max-w-[300px]">
    <!-- Logo -->
    <div id="logo" class="mx-auto mb-6 text-5xl font-black tracking-tighter text-base-content">
      Caleb<span class="text-primary">Mwangi</span>
    </div>

    <!-- Typing Effect -->
    <div class="font-mono text-base mb-6 text-base-content/70 min-h-[28px] flex items-center justify-center">
      <span id="typing-text"></span>
      <span class="inline-block w-1.5 h-5 bg-primary animate-pulse ml-1"></span>
    </div>

    <!-- Progress Bar -->
    <div class="w-64 mx-auto h-1 bg-base-300 rounded-full overflow-hidden">
      <div id="progress" class="h-full bg-gradient-to-r from-primary to-secondary w-0 rounded-full"></div>
    </div>

    <p class="mt-4 text-xs text-base-content/60">Loading portfolio...</p>
  </div>
</div>

<script is:inline>
  const preloader = document.getElementById('preloader');
  const typingElement = document.getElementById('typing-text');
  const progressBar = document.getElementById('progress');

  const messages = [
    "Booting portfolio...",
    "Loading projects...",
    "Almost ready ✨"
  ];

  function typeMessage(text, callback) {
    typingElement.textContent = '';
    let i = 0;
    const interval = setInterval(() => {
      if (i < text.length) {
        typingElement.textContent += text.charAt(i);
        i++;
      } else {
        clearInterval(interval);
        if (callback) setTimeout(callback, 300);
      }
    }, 50);
  }

  function startProgress() {
    let width = 0;
    const interval = setInterval(() => {
      width += 3;
      progressBar.style.width = width + '%';
      if (width >= 100) clearInterval(interval);
    }, 45);
  }

  function hidePreloader() {
    preloader.style.transition = 'opacity 0.8s ease';
    preloader.style.opacity = '0';
    setTimeout(() => {
      preloader.style.display = 'none';
    }, 800);
  }

  // Show loader only on first visit
  if (!sessionStorage.getItem('hasVisited')) {
    preloader.classList.remove('hidden');
    sessionStorage.setItem('hasVisited', 'true');

    startProgress();
    let index = 0;

    const showNext = () => {
      if (index < messages.length) {
        typeMessage(messages[index], () => {
          index++;
          showNext();
        });
      } else {
        setTimeout(hidePreloader, 800);
      }
    };

    showNext();
  } else {
    preloader.style.display = 'none';
  }
</script>